# ============================================
# EnvSetup.dev — Environment Variables
# Copy this file to .env.local and fill values
# ============================================

# --- Database (Neon DB — free tier) ---
# Get from: https://neon.tech → New Project → Connection string
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# --- AI (choose one) ---
# Option 1: Groq (FREE) → https://console.groq.com
GROQ_API_KEY=gsk_...

# Option 2: OpenAI (paid) → https://platform.openai.com
# OPENAI_API_KEY=sk-...

# --- Email / Newsletter (Brevo — free 300/day) ---
# Get from: https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-...

# --- Admin Dashboard ---
# Set a strong password — never commit real values!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
# Secret used to sign admin session cookies (HMAC). Falls back to ADMIN_PASSWORD if unset,
# but set a separate long random value in production.
ADMIN_SESSION_SECRET=change_me_random_long_secret

# --- Vercel Cron Security ---
# Random secret to protect /api/cron endpoints
CRON_SECRET=random_secret_here

# --- Optional GitHub sign-in (perks: /history + higher rate limit) ---
# The Wizard/AI Assistant/CLI all work fully without these — sign-in is
# optional. Only needed if you want the "Sign in with GitHub" button to work.
# 1. Create a GitHub OAuth App: https://github.com/settings/developers -> "New OAuth App"
#    - Homepage URL: https://www.envsetup.dev
#    - Authorization callback URL: https://www.envsetup.dev/api/auth/callback/github
#      (for local dev, also register http://localhost:3000/api/auth/callback/github)
# 2. Copy the generated Client ID and Client Secret below.
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# 3. Generate a random secret for NextAuth to sign session tokens with:
#    `openssl rand -base64 32`
NEXTAUTH_SECRET=random_secret_here
# 4. Set this to your deployed URL in production (Vercel), and
#    http://localhost:3000 for local dev.
NEXTAUTH_URL=https://www.envsetup.dev
